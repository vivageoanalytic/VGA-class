# Public build configuration. Never put Google credentials in VITE_* variables.
VITE_WHATSAPP_NUMBER=6285142296149
VITE_SITE_URL=
VITE_SITE_INDEXABLE=false
# Explicit demo switch; false uses the read-only backend and NEVER falls back to demo.
VITE_SCHEDULE_DEMO=true
# Server-only. Apps Script takes precedence when set. See docs/GOOGLE_APPS_SCRIPT_SETUP.md.
GOOGLE_APPS_SCRIPT_URL=
# Server-only; must match the API_SECRET Script property in Google Apps Script.
API_SECRET=
# ttl works locally; changes enables trigger invalidation once the public webhook is installed.
CALENDAR_CACHE_MODE=ttl
# Independent server-only key, matching VGA_WEBHOOK_SECRET in Apps Script.
CALENDAR_WEBHOOK_SECRET=
# Alternative: direct OAuth with calendar.events.readonly scope. Not needed for Apps Script.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# JSON mapping of public mentor IDs to private teaching calendar IDs.
GOOGLE_MENTOR_CALENDARS=
PORT=3001
HOST=127.0.0.1
# Keep false until publication content has been approved. Rebuild with VITE_SITE_URL too.
SITE_INDEXABLE=false
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
